# Application
PROJECT_NAME="Multi-Agent Research & Report System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# Database Configuration
# Local SQLite default:
